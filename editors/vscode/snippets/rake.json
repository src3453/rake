{
  "Macro declaration": {
    "prefix": "macro",
    "body": ["macro! ${1:name} (${2:argument}) {", "    $0", "}"],
    "description": "Declare a token substitution macro"
  },
  "Variable declaration": {
    "prefix": "var",
    "body": "var ${1:name}: ${2:int} = ${3:0}",
    "description": "Declare a mutable variable"
  },
  "Constant declaration": {
    "prefix": "const",
    "body": "const ${1:name}: ${2:int} = ${3:0}",
    "description": "Declare a constant"
  },
  "Function declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:amount}: ${3:int}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a function with a typed parameter"
  },
  "Warp function declaration": {
    "prefix": "warp fn",
    "body": [
      "warp fn ${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Declare a function that runs without screen refresh"
  },
  "Event handler": {
    "prefix": "event",
    "body": [
      "event ${1:Scratch.Events.greenFlag} {",
      "    $0",
      "}"
    ],
    "description": "Declare a Scratch event handler"
  },
  "Custom message receiver": {
    "prefix": "eventmsg",
    "body": [
      "event ${1:message} {",
      "    $0",
      "}"
    ],
    "description": "Receive a Scratch broadcast message"
  },
  "Send custom message": {
    "prefix": "send",
    "body": "send ${1:message}",
    "description": "Broadcast a custom Scratch message"
  },
  "Import Scratch events": {
    "prefix": "useevents",
    "body": "use Scratch.Events as Events",
    "description": "Import Scratch built-in events with an alias"
  },
  "Class declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    var ${2:value}: ${3:int} = ${4:0}",
      "    $0",
      "}"
    ],
    "description": "Declare a class with public fields"
  },
  "Enum declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:First},",
      "    ${3:Second},",
      "}"
    ],
    "description": "Declare a compile-time enum"
  },
  "Method declaration": {
    "prefix": "method",
    "body": [
      "public fn ${1:name}(${2}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a public class method"
  },
  "Private method declaration": {
    "prefix": "private method",
    "body": [
      "private fn ${1:name}(${2}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a private class method"
  },
  "Constructor method": {
    "prefix": "new method",
    "body": [
      "fn new() {",
      "    $0",
      "    return self",
      "}"
    ],
    "description": "Declare a constructor that returns self"
  },
  "Scratch list creation": {
    "prefix": "slist",
    "body": [
      "use Scratch.Generics.List as SList",
      "use Scratch.Generics.Value as SValue",
      "",
      "var ${1:inventory}: SList = SList.new()",
      "$0"
    ],
    "description": "Create a Stage-wide Scratch list"
  },
  "Scratch list get": {
    "prefix": "listget",
    "body": "${1:inventory}.get(${2:1})",
    "description": "Read a one-based item from a Scratch list"
  },
  "Scratch list set": {
    "prefix": "listset",
    "body": "${1:inventory}.set(${2:1}, ${3:value})",
    "description": "Replace a one-based item in a Scratch list"
  },
  "Namespace declaration": {
    "prefix": "ns",
    "body": [
      "ns ${1:Graphics} {",
      "    $0",
      "}"
    ],
    "description": "Group declarations in an UpperCamelCase namespace"
  },
  "Import Scratch Motion blocks": {
    "prefix": "usemotion",
    "body": "use Scratch.Motion as motion",
    "description": "Import the Scratch Motion block namespace with an alias"
  },
  "Import selected Scratch Motion blocks": {
    "prefix": "usemoves",
    "body": "use Scratch.Motion.{move, rotate, rotateCW, rotateCCW}",
    "description": "Import selected Scratch Motion blocks"
  },
  "Function call": {
    "prefix": "call",
    "body": "${1:functionName}(${2:argument})",
    "description": "Call a function"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create an if statement"
  },
  "If else statement": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create an if/else statement"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create a while loop"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:State.First} => ${3:first_value},",
      "    ${4:State.Second} => ${5:second_value},",
      "    _ => ${6:default_value},",
      "}"
    ],
    "description": "Match enum variants or scalar values and return one arm value"
  }
}
