{
  "Variable declaration": {
    "prefix": "var",
    "body": "var ${1:name}: ${2:int} = ${3:0}",
    "description": "Declare a mutable variable"
  },
  "Constant declaration": {
    "prefix": "const",
    "body": "const ${1:name}: ${2:int} = ${3:0}",
    "description": "Declare a constant"
  },
  "Function declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:amount}: ${3:int}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a function with a typed parameter"
  },
  "Warp function declaration": {
    "prefix": "warp fn",
    "body": [
      "warp fn ${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Declare a function that runs without screen refresh"
  },
  "Event handler": {
    "prefix": "event",
    "body": [
      "event ${1:greenFlag}() ${2:main} {",
      "    $0",
      "}"
    ],
    "description": "Declare a Scratch event handler"
  },
  "Class declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    var ${2:value}: ${3:int} = ${4:0}",
      "    $0",
      "}"
    ],
    "description": "Declare a class with fields"
  },
  "Scratch list creation": {
    "prefix": "slist",
    "body": [
      "use Scratch.Generics.List as SList",
      "use Scratch.Generics.Value as SValue",
      "",
      "var ${1:inventory}: SList = SList.new()",
      "$0"
    ],
    "description": "Create a Stage-wide Scratch list"
  },
  "Scratch list get": {
    "prefix": "listget",
    "body": "${1:inventory}.get(${2:1})",
    "description": "Read a one-based item from a Scratch list"
  },
  "Scratch list set": {
    "prefix": "listset",
    "body": "${1:inventory}.set(${2:1}, ${3:value})",
    "description": "Replace a one-based item in a Scratch list"
  },
  "Namespace declaration": {
    "prefix": "ns",
    "body": [
      "ns ${1:Graphics} {",
      "    $0",
      "}"
    ],
    "description": "Group declarations in an UpperCamelCase namespace"
  },
  "Import Scratch Motion blocks": {
    "prefix": "usemotion",
    "body": "use Scratch.Motion as motion",
    "description": "Import the Scratch Motion block namespace with an alias"
  },
  "Import selected Scratch Motion blocks": {
    "prefix": "usemoves",
    "body": "use Scratch.Motion.{move, rotate, rotateCW, rotateCCW}",
    "description": "Import selected Scratch Motion blocks"
  },
  "Function call": {
    "prefix": "call",
    "body": "${1:functionName}(${2:argument})",
    "description": "Call a function"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create an if statement"
  },
  "If else statement": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create an if/else statement"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create a while loop"
  }
}
