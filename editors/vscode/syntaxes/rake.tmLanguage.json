{
  "scopeName": "source.rake",
  "patterns": [
    {"include": "#comments"},
    {"include": "#functions"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#booleans"},
    {"include": "#numbers"},
    {"include": "#operators"},
    {"include": "#punctuation"}
  ],
  "repository": {
    "functions": {
      "patterns": [
        {"name": "entity.name.function.rake", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.rake", "match": "//.*$"}
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rake",
          "match": "\\b(var|const|class|fn|if|else|while|return)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {"name": "storage.type.rake", "match": "\\b(int|float|bool)\\b"}
      ]
    },
    "booleans": {
      "patterns": [
        {"name": "constant.language.boolean.rake", "match": "\\b(true|false)\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.rake", "match": "\\b[0-9]+(\\.[0-9]+)?\\b"}
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rake",
          "match": "->|==|!=|<=|>=|&&|\\|\\||\\+=|-=|[+*/<>=!-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {"name": "punctuation.section.block.begin.rake", "match": "[{}()]"},
        {"name": "punctuation.separator.rake", "match": "[.:,;]"}
      ]
    }
  }
}
