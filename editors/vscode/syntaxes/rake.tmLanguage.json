{
  "scopeName": "source.rake",
  "patterns": [
    {"include": "#comments"},
    {"include": "#generic-types"},
    {"include": "#namespaces"},
    {"include": "#functions"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#booleans"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#operators"},
    {"include": "#punctuation"}
  ],
  "repository": {
    "namespaces": {
      "patterns": [
        {"name": "keyword.control.namespace.rake", "match": "\\b(ns|use|as)\\b"},
        {"name": "support.namespace.rake", "match": "\\bScratch(?:\\.[A-Z][A-Za-z0-9_]*)*"},
        {"name": "entity.name.namespace.rake", "match": "(?<=\\bns\\s)[A-Za-z_][A-Za-z0-9_]*"}
      ]
    },
    "generic-types": {
      "patterns": [
        {"name": "storage.type.rake", "match": "\\bScratch\\.Generics\\.(Value|List)\\b"}
      ]
    },
    "functions": {
      "patterns": [
        {"name": "entity.name.function.rake", "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"}
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.rake", "match": "//.*$"}
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rake",
          "match": "\\b(var|const|class|fn|if|else|while|return)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {"name": "storage.type.rake", "match": "\\b(int|float|bool|text)\\b"}
      ]
    },
    "booleans": {
      "patterns": [
        {"name": "constant.language.boolean.rake", "match": "\\b(true|false)\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.rake", "match": "\\b[0-9]+(\\.[0-9]+)?\\b"}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.quoted.double.rake", "match": "\"(?:\\\\.|[^\"\\\\])*\""}
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rake",
          "match": "->|==|!=|<=|>=|&&|\\|\\||\\+=|-=|[+*/<>=!-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {"name": "punctuation.section.block.begin.rake", "match": "[{}()]"},
        {"name": "punctuation.separator.rake", "match": "[.:,;]"}
      ]
    }
  }
}
