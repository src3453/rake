class Vector2 {
    public var x: float = 0.0
    public var y: float = 0.0
    private const unit: float = 1.0

    fn new() {
        return self
    }

    public fn move(dx: float, dy: float) {
        self.x += dx * self.unit
        self.y += dy * self.unit
    }
}

var player_position: Vector2 = Vector2.new()
var enemy_position: Vector2 = Vector2.new()

player_position.move(12.0, 4.0)
enemy_position.move(-8.0, 6.0)

var player_is_to_the_right = player_position.x > enemy_position.x

if player_is_to_the_right {
    player_position.x += 1.0
}
