use Scratch.Events as events

event events.greenFlag {
    Scratch.Looks.say("Ready")
    send begin
}

event events.keyPressed("space") {
    Scratch.Looks.say("Space pressed")
}

event begin {
    Scratch.Looks.say("Started")
}

event begin {
    Scratch.Looks.say("A second script receives the same message")
}
